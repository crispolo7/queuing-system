# Copy this file to .env. Never commit .env.

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_value

ADMIN_USERNAME=replace_with_admin_username

# Generate with:
# python -c "from getpass import getpass; from werkzeug.security import generate_password_hash; print(generate_password_hash(getpass()))"
ADMIN_PASSWORD_HASH=replace_with_a_werkzeug_password_hash

# Keep localhost unless the application is placed behind an HTTPS reverse proxy.
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
SESSION_COOKIE_SECURE=false
QUEUE_DB_PATH=queue.db

# Optional SQLAlchemy database URL. Leave unset for local SQLite.
# DATABASE_URL=
